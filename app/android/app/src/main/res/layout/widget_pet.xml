<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pet_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_pet"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="10dp">

    <ImageView
        android:id="@+id/pet_image"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:adjustViewBounds="true"
        android:contentDescription="Mascota"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/pet_streak"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔥 0 días"
        android:textColor="#2B1B43"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/pet_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#7041B8"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/pet_level"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#8C819E"
        android:textSize="10sp" />
</LinearLayout>
